# ── chiron-web 启动说明（Next.js 16 前台）──────────────────────────────
# 1) npm install
# 2) 默认走内置 mock（无需后端）：npm run dev 后打开 http://localhost:3000
#    mock 登录：任意邮箱 + 任意密码；推荐 demo@example.com / Demo!2026
# 3) 接真实后端：把 NEXT_PUBLIC_USE_MOCK 设为 0，并启动 chiron-server（默认 127.0.0.1:8088）；
#    /api/v1/* 由 web/app/api/v1/[...path]/route.ts 同源反代，Host 强制为租户域名。
# 4) 校验：npm run typecheck && npm run build

# 1 = 使用内存 mock（默认）；0 = 走真实 HTTP
NEXT_PUBLIC_USE_MOCK=1
# 真实模式下 API 前缀；留空 = 同源 /api/v1（推荐，走本地反代）
NEXT_PUBLIC_API_BASE=

# 仅服务端读取：Route Handler 反代的上游地址与（仅开发）租户 Host。
# 生产环境忽略 CHIRON_DEV_TENANT_HOST，沿用浏览器请求的真实 Host，避免跨租户串流。
CHIRON_API_ORIGIN=http://127.0.0.1:8088
CHIRON_DEV_TENANT_HOST=acme.apps.test.local
