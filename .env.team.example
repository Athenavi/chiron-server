# chiron-server 团队部署环境变量模板（API-only）。
#
# 复制为 .env.team 后再填值；.env.team 已在 .gitignore 里，**永远不要提交**。
# 所有变量名都对应 src/config.rs / src/sandbox.rs 里的读取点，拼错不会报错，只会静默用默认值。
#
#   cp .env.team.example .env.team && chmod 600 .env.team
#   docker compose --env-file .env.team -f docker-compose.team.yml up -d --build

# ── 身份与 Cookie ──────────────────────────────────────────────────────
# 至少 32 字符；生成：openssl rand -hex 32。换它等于让全部 token 失效。
JWT_SECRET=
JWT_HOURS=24
# 走 HTTPS 反代时必须为 1；纯回环调试才置 0。
COOKIE_SECURE=1

# ── 服务模式 ───────────────────────────────────────────────────────────
# team 关闭公开注册；CHIRON_SERVICE_MODE=1 与 team 同义（任一为真即团队模式）。
CHIRON_DEPLOY_MODE=team
CHIRON_SERVICE_MODE=1
# 默认模型（<provider>:<model> 可选）；密钥见文末 provider 段。
CHIRON_DEFAULT_MODEL=gpt-5-mini
CHIRON_DEFAULT_PROVIDER=

# ── 数据库 / Redis ─────────────────────────────────────────────────────
# 部署区域标识（多区域时用于 /healthz、/metrics 与新租户默认 region）。
CHIRON_REGION=
# 双活/多区域建议置 1：拒绝 region 为空/default 的租户被任意区域服务。
CHIRON_REGION_STRICT=0
# 只读副本/备用区：1 时租户 API 只允许 GET/HEAD/OPTIONS。
CHIRON_READ_ONLY=0
# Redis HA（可选）：非空时优先 Sentinel；REDIS_URL 作为单节点回退。
# CHIRON_REDIS_SENTINEL_URLS=redis://sentinel1:26379,redis://sentinel2:26379
# CHIRON_REDIS_SENTINEL_MASTER=mymaster
# CHIRON_REDIS_PASSWORD=
# DATABASE_URL 与 REDIS_URL 由 docker-compose.team.yml 按服务名组装（postgres / redis），
# 这里不要重复写，避免密码两处不同步。只用 POSTGRES_* 作为唯一来源。
POSTGRES_USER=chiron
POSTGRES_PASSWORD=
POSTGRES_DB=chiron

# ── 平台控制面 / 租户开通 ──────────────────────────────────────────────
# 平台控制台域名（/api/platform/v1 只在该 Host 可用）；开发态留空 = 仅回环。
PLATFORM_HOST=platform.example.com
# 租户子域名基域：<slug>.<base>；留空则不自动建子域名记录。
TENANT_BASE_DOMAIN=apps.example.com
# 控制库 DSN 由 compose 组装成服务名（chiron_control）。
# 非 compose 部署时手填；该角色需要 CREATEDB / CREATEROLE（万人级建议独立角色）。
# CONTROL_DATABASE_URL=postgresql://chiron:***@postgres:5432/chiron_control
# 开通用的管理连接；留空复用 CONTROL_DATABASE_URL。
PROVISION_DATABASE_URL=
# 平台管理员引导：控制库为空时首次启动创建；登录后请改密并收紧访问。
PLATFORM_BOOTSTRAP_EMAIL=
PLATFORM_BOOTSTRAP_PASSWORD=
# 控制库落库加密密钥（DSN / owner 临时密码）：openssl rand -base64 32。
# 丢失后已开通租户的 DSN 与未领取的临时密码都无法解密。
SECRETS_KEY=
# 租户连接池：每库连接数 / 注册表上限 / 空闲回收秒数。
CHIRON_TENANT_POOL_MAX=10
CHIRON_TENANT_POOLS_MAX=64
CHIRON_TENANT_POOL_IDLE_SECS=300
# 定时用量汇总间隔（秒，0=关闭；leader 租约，窗口 3 天）。
CHIRON_USAGE_ROLLUP_SECS=3600
# 租户 pg_dump 备份目录（容器内路径，需挂载持久卷）；留空则禁用备份接口。
CHIRON_BACKUP_DIR=
# 定时备份间隔（秒，0=关闭，最小值 300）与保留天数（0=不删除）。
CHIRON_BACKUP_SECS=0
CHIRON_BACKUP_KEEP_DAYS=0
# 失败告警 Webhook（JSON POST）；留空关闭。
CHIRON_ALERT_WEBHOOK_URL=
CHIRON_ALERT_COOLDOWN_SECS=1800
# 团队/服务模式必填；空值会被拒绝启动。
CHIRON_METRICS_TOKEN=
# 外部支付回写 HMAC 密钥；空 = 关闭 /billing/webhook。
CHIRON_BILLING_WEBHOOK_SECRET=
# 支付宝（RSA2）。私钥用应用私钥 PKCS8/PKCS1；公钥填支付宝公钥；PEM 可用 \n 转义。
# 控制台“集成配置”保存的值优先于这里（需 SECRETS_KEY）。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# MCP stdio 宿主命令白名单；空 = 全部拒绝（生产保持为空或仅信任命令）。
CHIRON_MCP_COMMANDS=
# 容量阈值（0=关闭）：默认库活跃 run / 缓存租户池；跨阈值告警一次。
CHIRON_ALERT_ACTIVE_RUNS=0
CHIRON_ALERT_TENANT_POOLS=0
# 单个看门狗窗口内 egress 拒绝数达到该值告警（0=关闭）。
CHIRON_ALERT_EGRESS_DENIED=0
# 域名 TLS 状态探测（秒，0=关闭；最小 300）；探测失败会写 tls_status=failed 并告警。
CHIRON_TLS_PROBE_SECS=0
CHIRON_TLS_PROBE_TIMEOUT_SECS=5
# 媒体存储：local（默认）| webdav | s3；控制台“系统配置”加密保存的值优先于这里。
CHIRON_MEDIA_BACKEND=local
CHIRON_MEDIA_ROOT=
# webdav 后端（BACKEND=webdav 时 URL 必填；用户名/密码需同时提供）。
CHIRON_MEDIA_WEBDAV_URL=
CHIRON_MEDIA_WEBDAV_USERNAME=
CHIRON_MEDIA_WEBDAV_PASSWORD=
CHIRON_MEDIA_WEBDAV_PREFIX=
# s3 后端（BACKEND=s3 时 bucket + access/secret 必填；兼容 MinIO）。
CHIRON_MEDIA_S3_BUCKET=
CHIRON_MEDIA_S3_REGION=us-east-1
CHIRON_MEDIA_S3_ENDPOINT=
CHIRON_MEDIA_S3_ACCESS_KEY=
CHIRON_MEDIA_S3_SECRET_KEY=
CHIRON_MEDIA_S3_SESSION_TOKEN=
CHIRON_MEDIA_S3_PATH_STYLE=
CHIRON_MEDIA_S3_PREFIX=
# egress 正向代理：监听地址 + 沙箱内可见地址。egress_mode=proxy 的套餐走白名单。
# 注意代理端口需要容器可达（bridge 网关 + --add-host host.docker.internal）。
CHIRON_EGRESS_PROXY_BIND=0.0.0.0:3128
CHIRON_EGRESS_PROXY_ADDR=host.docker.internal:3128
# 默认只允许 HTTPS(CONNECT:443)；确需明文 HTTP 才置 1。
CHIRON_EGRESS_ALLOW_PLAINTEXT=0
# 附加在默认系统提示之后的部署级提示（可选）。
CHIRON_SYSTEM_PROMPT=

# ── 宿主 docker 组 ─────────────────────────────────────────────────────
# 服务端非 root（UID 1000），要靠附加组访问 /var/run/docker.sock：
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# ── Agent sandbox（sysbox）─────────────────────────────────────────────
# 粒度 user | project；镜像需先构建：docker build -t chiron-agent:py314 deploy/agent
SANDBOX_SCOPE=user
SANDBOX_IMAGE=chiron-agent:py314
# 必须是宿主已注册的 runtime（docker info 里能看到 sysbox-runc）；未装 sysbox 时先切 runc 验证。
SANDBOX_DOCKER_RUNTIME=sysbox-runc
# 宿主路径；compose 以同路径挂进服务端容器，改这里要同步改 compose 的 volume。
SANDBOX_DATA_ROOT=/var/agent-data
# bridge 才能 git/pip；需要更严时切 none。
# 生产默认断网；需要上网请用 proxy（白名单）而不是 bridge（无隔离）。
SANDBOX_NETWORK=none
# 单容器上限；重型任务可单独放宽到 1g。
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0
SANDBOX_PIDS=256
# 空闲多久回收容器（秒）；回收后数据卷保留。
SANDBOX_IDLE_SECS=1800
SANDBOX_EXEC_TIMEOUT_SECS=120

# ── 子 Agent（B6）──────────────────────────────────────────────────────
CHIRON_SUBAGENT_ENABLED=1
CHIRON_SUBAGENT_MAX_DEPTH=2
CHIRON_SUBAGENT_MAX_CHILDREN=3
CHIRON_SUBAGENT_MAX_CONCURRENT=6
# 子 Agent 没有审批通道，默认禁止写/执行类工具。
CHIRON_SUBAGENT_ALLOW_MUTATING=0

# ── 检查点 / 巡检（B7）─────────────────────────────────────────────────
CHIRON_CHECKPOINT_ENABLED=1
CHIRON_CHECKPOINT_INTERVAL_SECS=30
CHIRON_CHECKPOINT_RETENTION_DAYS=7

# ── 限流（B10）─────────────────────────────────────────────────────────
# 三级桶：主体按本参数，租户 ×4，全局 ×20（倍数写死在代码里）。
CHIRON_RATE_LIMIT_ENABLED=1
CHIRON_RL_LOGIN_BURST=10
CHIRON_RL_LOGIN_PER_MINUTE=10
CHIRON_RL_SUBMIT_BURST=10
CHIRON_RL_SUBMIT_PER_MINUTE=30
CHIRON_RL_TOOL_BURST=30
CHIRON_RL_TOOL_PER_MINUTE=120

# ── 集成与网络策略（B9）────────────────────────────────────────────────
# 生产保持关闭，挡 SSRF。
CHIRON_WEB_FETCH_ALLOW_PRIVATE=0
CHIRON_MCP_ALLOW_PRIVATE=0
# 关掉 MCP/插件/技能/市场总开关时置 1（路由仍在，但一律 403）。
CHIRON_INTEGRATION_DISABLED=0

# ── Provider 密钥（占位，按需填）───────────────────────────────────────
# 完整 preset 见 src/providers.rs；只有填了 key 的 provider 才可用，空值等同未设置。
# 国际
# 平台 provider 回落 key；租户 BYOK 优先，控制台“系统配置”可加密覆盖。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
# 国内
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=
BAICHUAN_API_KEY=
HUNYUAN_API_KEY=
STEPFUN_API_KEY=
# 聚合 / 自建
OPENROUTER_API_KEY=
SILICONFLOW_API_KEY=
ONEAPI_API_KEY=
OPENCODE_API_KEY=
OPENCODE_GO_API_KEY=
# 本地（key 可留空，但要用 CHIRON_PROVIDER_<ID>_BASE_URL 指定端点）
OLLAMA_API_KEY=
VLLM_API_KEY=
LMSTUDIO_API_KEY=
# 自定义网关：slug 见 src/provider/catalog.rs（custom → CHIRON_PROVIDER_CUSTOM_BASE_URL）
CUSTOM_API_KEY=
CUSTOM_ANTHROPIC_API_KEY=
# CHIRON_PROVIDER_CUSTOM_BASE_URL=https://llm.internal.example/v1
# 套餐白名单额外放行（如 OpenCode Go 的 claude 系）：逗号分隔模型族
# CHIRON_PLAN_ALLOW_EXTRA=
