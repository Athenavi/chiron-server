# chiron-server（API-only）
BIND_ADDR=127.0.0.1:8088
DATABASE_URL=postgresql://chiron:chiron@127.0.0.1:5432/chiron
REDIS_URL=redis://127.0.0.1:6379/0

# 至少 32 字符；生产必须独立生成
# 生成：openssl rand -hex 32（占位值会被拒绝启动）。
JWT_SECRET=
# 团队模式必填：/metrics Bearer token（任意随机串）。
CHIRON_METRICS_TOKEN=
JWT_HOURS=24
# 仅纯 HTTP 本地调试用 0；HTTPS/团队部署必须 1（未设置时代码按团队模式默认 Secure）。
COOKIE_SECURE=0

# desktop | team；team 关闭公开注册（本服务不提供注册路由）
CHIRON_DEPLOY_MODE=team
# 运行层服务模式（与部署级 team 同义，任一为真即团队模式）
CHIRON_SERVICE_MODE=1

# ── 平台控制面 / 租户开通（可选）──
# 配置后启用 /api/platform/v1 与租户自动开通；连接角色需要 CREATEDB/CREATEROLE。
CONTROL_DATABASE_URL=postgresql://chiron:chiron@127.0.0.1:5432/chiron_control
# PROVISION_DATABASE_URL 留空则复用 CONTROL_DATABASE_URL
PROVISION_DATABASE_URL=
# 平台控制台 Host；留空只允许回环访问平台 API
PLATFORM_HOST=
# 租户子域名基域：<slug>.<base>；留空则不自动建子域名记录
TENANT_BASE_DOMAIN=
# 平台管理员引导（控制库无管理员时首次启动创建）
PLATFORM_BOOTSTRAP_EMAIL=
PLATFORM_BOOTSTRAP_PASSWORD=
# 控制库敏感字段（DSN / owner 临时密码）加密密钥：base64 的 32 字节
# 生成：openssl rand -base64 32
SECRETS_KEY=

# ── Agent 容器（sysbox）──
# 粒度：user | project
SANDBOX_SCOPE=user
SANDBOX_IMAGE=chiron-agent:py314
SANDBOX_DOCKER_RUNTIME=sysbox-runc
SANDBOX_DATA_ROOT=/var/agent-data
SANDBOX_NETWORK=bridge
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0
SANDBOX_PIDS=256

# ── 子 Agent（B6）──
CHIRON_SUBAGENT_ENABLED=1
# 嵌套深度 / 单父并发 / 整棵树并发
CHIRON_SUBAGENT_MAX_DEPTH=2
CHIRON_SUBAGENT_MAX_CHILDREN=3
CHIRON_SUBAGENT_MAX_CONCURRENT=6
# 子 Agent 预算（单次）
CHIRON_SUBAGENT_MAX_STEPS=6
CHIRON_SUBAGENT_MAX_TOOL_CALLS=20
CHIRON_SUBAGENT_MAX_TOTAL_TOKENS=60000
CHIRON_SUBAGENT_TIMEOUT_SECS=600
# 子 Agent 默认没有审批通道：1 = 允许写/执行类工具（谨慎开启）
CHIRON_SUBAGENT_ALLOW_MUTATING=0

# ── 检查点 / 巡检（B7）──
CHIRON_CHECKPOINT_ENABLED=1
CHIRON_CHECKPOINT_INTERVAL_SECS=30
CHIRON_CHECKPOINT_LEASE_SECS=60
CHIRON_CHECKPOINT_HOT_WINDOW_SECS=120
CHIRON_CHECKPOINT_COLD_WINDOW_SECS=3600
CHIRON_CHECKPOINT_MAX_ATTEMPTS=3
CHIRON_CHECKPOINT_RETAIN_PER_RUN=20
CHIRON_CHECKPOINT_RETENTION_DAYS=7
# 工作区 git 快照；REPO 是容器内 /workspace 下的相对路径
CHIRON_CHECKPOINT_WORKSPACE=1
CHIRON_CHECKPOINT_REPO=.
